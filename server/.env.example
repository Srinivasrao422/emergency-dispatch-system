# ResQDispatch Server Environment Configuration Template
# Copy this file to .env and configure your local or hosted service credentials

PORT=5000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/resqdispatch?schema=public"

# Cross-Origin Resource Sharing (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5000,http://localhost:5173"

# ========================================================
# PHASE 8: EXTERNAL SERVICE PROVIDER CONFIGURATIONS
# ========================================================

# 1. Razorpay Payment Gateway (Test Mode: rzp_test_...)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="INR"

# 2. WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# 3. MSG91 SMS Gateway (India Telecom DLT Approved)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_DLT_TE_ID=""

# 4. Supabase Cloud Object Storage
SUPABASE_STORAGE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# 5. Road Routing & Real-Time Navigation
# OSRM public or private road routing instance URL (defaults to router.project-osrm.org)
OSRM_ROUTING_URL="https://router.project-osrm.org"
# Optional Google Maps Routes/Directions API Key
GOOGLE_MAPS_API_KEY=""
